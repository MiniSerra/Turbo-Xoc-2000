rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil privat de cada jugador: només el seu propietari el pot llegir i escriure
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['profile', 'race', 'name', 'updated'])
        && request.resource.data.profile is string && request.resource.data.profile.size() < 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 12;
    }

    // Rànquing mundial de la Gran Cursa: tothom el pot veure, cadascú només escriu el seu temps
    match /race/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t', 'name', 'profile', 'splits', 'd'])
        && request.resource.data.t is number && request.resource.data.t > 25 && request.resource.data.t < 600
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.profile is string && request.resource.data.profile.size() < 200;
    }
  }
}
